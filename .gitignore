# machine-local shim: symlinks into the HF cache, recreated by
# scripts/make_mistral_shim.sh
data/mistral_small_24b_hf/
__pycache__/
*.pyc

# Source-native external datasets are fetched by scripts/fetch_external_sources.py.
# They are intentionally not committed: some sources are large, dynamically
# updated, share-alike/non-commercial, or have redistribution terms that still
# require verification.  Reproducibility is provided by pinned URLs + hashes.
data/external/raw/

# generated by src/make_figures.py from committed result JSONs
figures/

# Regenerable high-dimensional activation caches; generated-output estimands
# and summaries remain committed under results/mech/.
results/mech/*_states.npz

# G33 official checkpoint/tokenizer restored at pinned revision; hashes retained.
data/external/g33_mistral_checkpoint/
data/external/g33_mistral_tokenizer/

# Cross-host G33 writer locks.
results/raw/*g33*.jsonl.lock

# Local runtime caches and agent/account configuration.
.pytest_cache/
.agents/
.codex/
.aws/

# Garden-path behavioral runs: per-pair raw scores are large and regenerable
# (deterministic, code + materials committed); SHA-256 recorded in results/gp/<exp>/MANIFEST.sha256
results/gp/*/*.scores.csv.gz
logs/gp/
