import json, collections
ids=[]; rel=collections.Counter(); nat=collections.Counter(); bad=[]
for i,line in enumerate(open('audit_batch_03.jsonl'),1):
    line=line.strip()
    if not line: continue
    try: r=json.loads(line)
    except Exception as e: bad.append((i,str(e))); continue
    assert set(r)== {'id','relevance','naturalness','issue'}, (i, set(r))
    ids.append(r['id']); rel[r['relevance']]+=1; nat[r['naturalness']]+=1
print("records:", len(ids))
print("unique:", len(set(ids)), "dupes:", [k for k,v in collections.Counter(ids).items() if v>1])
print("relevance:", dict(rel))
print("naturalness:", dict(nat))
print("bad json:", bad)
blind=[json.loads(l)['id'] for l in open('blind_batch_03.jsonl') if l.strip()]
print("missing vs blind:", set(blind)-set(ids))
print("extra vs blind:", set(ids)-set(blind))
