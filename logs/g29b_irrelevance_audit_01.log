import json

with open('data/items/g29b_blind_irrelevance_v1/audit_01.jsonl', 'r') as f:
    lines = f.readlines()

print(f'Total records: {len(lines)}')
print()

expected_ids = ['g29_000','g29_001','g29_003','g29_004','g29_007','g29_008','g29_009','g29_011','g29_012','g29_013','g29_015','g29_016','g29_017','g29_018','g29_019','g29_020','g29_022','g29_023','g29_026','g29_027']

all_valid = True
for i, line in enumerate(lines):
    try:
        obj = json.loads(line.strip())
        keys = set(obj.keys())
        expected_keys = {'id', 'selected_index', 'issue'}
        keys_valid = keys == expected_keys
        idx = obj['selected_index']
        idx_valid = idx in [0, 1, 2, -1]
        issue_valid = isinstance(obj['issue'], str) and len(obj['issue']) > 0
        id_match = obj['id'] == expected_ids[i]
        status = 'OK' if (keys_valid and idx_valid and issue_valid and id_match) else 'FAIL'
        if status == 'FAIL':
            all_valid = False
        print(f'{obj[\"id\"]}: idx={idx}, keys_valid={keys_valid}, idx_valid={idx_valid}, issue_valid={issue_valid}, id_match={id_match} -> {status}')
    except Exception as e:
        all_valid = False
        print(f'Line {i+1}: PARSE ERROR - {e}')

print()
print(f'All 20 records valid: {all_valid}')
print(f'All IDs match input order: {all_valid}')
"

