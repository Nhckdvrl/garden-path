import json

with open('data/items/g29_blind_audit_v1/blind_05.jsonl', 'r') as f:
    input_ids = [json.loads(line)['id'] for line in f if line.strip()]

with open('data/items/g29_blind_audit_v1/audit_05.jsonl', 'r') as f:
    output_records = [json.loads(line) for line in f if line.strip()]

output_ids = [r['id'] for r in output_records]

assert len(output_records) == 20, f'Expected 20 records, got {len(output_records)}'
assert input_ids == output_ids, f'ID mismatch: {input_ids} vs {output_ids}'
assert all(set(r.keys()) == {'id','relation_a','relation_b','pair_valid','naturalness','issue'} for r in output_records), 'Key mismatch'
assert all(r['relation_a'] in ('support','refute','neutral','ambiguous') for r in output_records), 'Invalid relation_a'
assert all(r['relation_b'] in ('support','refute','neutral','ambiguous') for r in output_records), 'Invalid relation_b'
assert all(r['naturalness'] in ('natural','awkward','broken') for r in output_records), 'Invalid naturalness'
assert all(isinstance(r['pair_valid'], bool) for r in output_records), 'Invalid pair_valid'

print('All 20 records valid JSONL. IDs match input order exactly.')
print(f'Input IDs:  {input_ids}')
print(f'Output IDs: {output_ids}')
