import json

with open('data/items/g29_blind_audit_v1/blind_06.jsonl', 'r') as f:
    input_ids = [json.loads(line)['id'] for line in f if line.strip()]

with open('data/items/g29_blind_audit_v1/audit_06.jsonl', 'r') as f:
    audit_records = [json.loads(line) for line in f if line.strip()]

assert len(audit_records) == 20, f'Expected 20 records, got {len(audit_records)}'
assert [r['id'] for r in audit_records] == input_ids, 'ID mismatch or order mismatch'

required_keys = {'id', 'relation_a', 'relation_b', 'pair_valid', 'naturalness', 'issue'}
for r in audit_records:
    assert set(r.keys()) == required_keys, f\"Bad keys in {r['id']}: {set(r.keys())}\"
    assert r['relation_a'] in ('support', 'refute', 'neutral', 'ambiguous'), f\"Bad relation_a in {r['id']}\"
    assert r['relation_b'] in ('support', 'refute', 'neutral', 'ambiguous'), f\"Bad relation_b in {r['id']}\"
    assert isinstance(r['pair_valid'], bool), f\"pair_valid not bool in {r['id']}\"
    assert r['naturalness'] in ('natural', 'awkward', 'broken'), f\"Bad naturalness in {r['id']}\"
    assert isinstance(r['issue'], str) and r['issue'], f\"Bad issue in {r['id']}\"

print('VERIFICATION PASSED: 20 records, valid JSON, correct IDs in input order, all fields present and well-typed.')
"
