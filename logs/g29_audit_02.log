import json
from collections import Counter
base='data/items/g29_blind_audit_v1/'
ids_in=[json.loads(l)['id'] for l in open(base+'blind_02.jsonl') if l.strip()]
out=[]
recs=[]
for i,line in enumerate(open(base+'audit_02.jsonl'),1):
    assert line.strip(), f'blank line {i}'
    d=json.loads(line)
    assert list(d.keys())==['id','relation_a','relation_b','pair_valid','naturalness','issue'], (i,list(d.keys()))
    assert d['relation_a'] in ('support','refute','neutral','ambiguous')
    assert d['relation_b'] in ('support','refute','neutral','ambiguous')
    assert isinstance(d['pair_valid'],bool)
    assert d['naturalness'] in ('natural','awkward','broken'), (i,d['naturalness'])
    assert isinstance(d['issue'],str) and d['issue'].strip()
    one=(d['relation_a']=='support')!=(d['relation_b']=='support')
    ref=('refute' in (d['relation_a'],d['relation_b']))
    assert d['pair_valid']==(one and ref), ('pair_valid inconsistent',d)
    out.append(d['id']); recs.append(d)
print('parsed records:',len(out))
print('id order matches input:',out==ids_in)
print('input ids:',ids_in)
print('output ids:',out)
print('relation_a:',Counter(r['relation_a'] for r in recs))
print('relation_b:',Counter(r['relation_b'] for r in recs))
print('pair_valid true:',sum(r['pair_valid'] for r in recs),'false:',sum(not r['pair_valid'] for r in recs))
print('naturalness:',Counter(r['naturalness'] for r in recs))
