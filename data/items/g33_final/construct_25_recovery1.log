import json
inp='data/items/g33_final/input_25.jsonl'
out='data/items/g33_final/generated_25_recovery1.jsonl'
ids_in=[json.loads(l)['id'] for l in open(inp) if l.strip()]
rows=[l for l in open(out) if l.strip()]
print('input_count',len(ids_in),'output_count',len(rows))
ids_out=[]
ok=True
req={'id','a_relation','b_relation','source_valid','x_a','x_b','reason'}
for i,l in enumerate(rows,1):
  try:
    o=json.loads(l)
  except Exception as e:
    print(f'row {i} JSON fail: {e}'); ok=False; continue
  if set(o.keys())!=req:
    print(f'row {i} keys {sorted(o.keys())}'); ok=False
  if o['a_relation'] not in ('support','refute','unclear') or o['b_relation'] not in ('support','refute','unclear'):
    print(f'row {i} bad relation'); ok=False
  if not isinstance(o['source_valid'],bool):
    print(f'row {i} bad source_valid'); ok=False
  if not o['reason']:
    print(f'row {i} empty reason'); ok=False
  if o['source_valid']:
    if not o['x_a'] or not o['x_b']:
      print(f'row {i} valid but empty x'); ok=False
    vals=sorted([o['a_relation'],o['b_relation']])
    if vals!=['refute','support']:
      print(f'row {i} valid but relations not support/refute split'); ok=False
  else:
    if o['x_a']!='' or o['x_b']!='':
      print(f'row {i} invalid but non-empty x'); ok=False
  ids_out.append(o.get('id'))
print('ids_match',ids_in==ids_out)
if ids_in!=ids_out:
  print('in ',ids_in)
  print('out',ids_out)
print('all_checks_pass',ok and ids_in==ids_out)
