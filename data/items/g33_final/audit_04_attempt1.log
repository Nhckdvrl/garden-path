# Parse each row and collect IDs
ids = []
for i, line in enumerate(lines, 1):
    try:
        row = json.loads(line.strip())
        ids.append(row['id'])
    except json.JSONDecodeError as e:
        print(f'JSON parse error on line {i}: {e}')

# Read the input file to compare IDs
with open('data/items/g33_final/review_04.jsonl', 'r') as f:
