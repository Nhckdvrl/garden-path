    row = json.loads(line.strip())
    input_ids.append(row['id'])

print(f'Input rows: {len(input_ids)}')
print(f'Output rows: {len(ids)}')
print(f'IDs match: {ids == input_ids}')
print(f'All IDs unique: {len(ids) == len(set(ids))}')

# Check required fields
required_fields = ['id', 'e_a_relation', 'e_b_relation', 'x_a_relation', 'x_b_relation', 'source_valid', 'faithful', 'natural', 'accept', 'reason']
for i, line in enumerate(lines, 1):
    row = json.loads(line.strip())
    missing = [f for f in required_fields if f not in row]
    if missing:
