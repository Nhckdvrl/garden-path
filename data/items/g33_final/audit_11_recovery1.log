import json

with open('data/items/g33_final/audit_11_recovery1.jsonl', 'r') as f:
    lines = f.readlines()

print(f'Row count: {len(lines)}')

ids = []
for i, line in enumerate(lines):
    try:
        row = json.loads(line)
        ids.append(row['id'])
    except json.JSONDecodeError as e:
        print(f'Row {i+1}: INVALID JSON - {e}')

with open('data/items/g33_final/review_11.jsonl', 'r') as f:
    input_ids = [json.loads(line)['id'] for line in f]

print(f'Input IDs: {input_ids}')
print(f'Output IDs: {ids}')
print(f'IDs match: {ids == input_ids}')

required_fields = ['id', 'e_a_relation', 'e_b_relation', 'x_a_relation', 'x_b_relation', 'source_valid', 'faithful', 'natural', 'accept', 'reason']
for i, line in enumerate(lines):
    row = json.loads(line)
    missing = [f for f in required_fields if f not in row]
    if missing:
        print(f'Row {i+1} ({row[\"id\"]}): Missing fields: {missing}')

print('Verification complete.')
