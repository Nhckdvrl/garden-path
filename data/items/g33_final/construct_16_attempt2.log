import json

input_path = '/home/xiang/research_hun/try_clone/data/items/g33_final/input_16.jsonl'
output_path = '/home/xiang/research_hun/try_clone/data/items/g33_final/generated_16_attempt2.jsonl'

with open(input_path, 'r') as f:
    input_lines = [line.strip() for line in f if line.strip()]

with open(output_path, 'r') as f:
    output_lines = [line.strip() for line in f if line.strip()]

print(f'Input rows: {len(input_lines)}')
print(f'Output rows: {len(output_lines)}')

all_valid = True
ids_match = True

for i in range(max(len(input_lines), len(output_lines))):
    try:
        input_obj = json.loads(input_lines[i])
        output_obj = json.loads(output_lines[i])
        
        if input_obj['id'] != output_obj['id']:
            print(f'ID mismatch at row {i}: input={input_obj[\"id\"]}, output={output_obj[\"id\"]}')
            ids_match = False
        
        required_keys = ['id', 'a_relation', 'b_relation', 'source_valid', 'x_a', 'x_b', 'reason']
        for key in required_keys:
            if key not in output_obj:
                print(f'Missing key \"{key}\" in row {i} ({output_obj.get(\"id\", \"unknown\")})')
                all_valid = False
        
        if not output_obj['source_valid'] and (output_obj['x_a'] != '' or output_obj['x_b'] != ''):
            print(f'Non-empty x values for invalid pair in row {i} ({output_obj[\"id\"]})')
            all_valid = False
        
    except Exception as e:
        print(f'JSON parse error at row {i}: {e}')
        all_valid = False

print(f'All JSON valid: {all_valid}')
print(f'IDs match: {ids_match}')
print(f'Row counts match: {len(input_lines) == len(output_lines)}')
"

