const fs = require('fs');

const inputPath = '/home/xiang/research_hun/try_clone/data/items/g33_final/input_28.jsonl';
const outputPath = '/home/xiang/research_hun/try_clone/data/items/g33_final/generated_28_attempt2.jsonl';

const inputLines = fs.readFileSync(inputPath, 'utf8').trim().split('\n');
const outputLines = fs.readFileSync(outputPath, 'utf8').trim().split('\n');

console.log('Input rows:', inputLines.length);
console.log('Output rows:', outputLines.length);

let allValid = true;
const inputIds = [];
const outputIds = [];

for (let i = 0; i < inputLines.length; i++) {
  try {
    const obj = JSON.parse(inputLines[i]);
    inputIds.push(obj.id);
  } catch (e) {
    console.log('Input row ' + (i+1) + ' JSON parse error: ' + e.message);
    allValid = false;
  }
}

for (let i = 0; i < outputLines.length; i++) {
  try {
    const obj = JSON.parse(outputLines[i]);
    outputIds.push(obj.id);
    
    const requiredKeys = ['id', 'a_relation', 'b_relation', 'source_valid', 'x_a', 'x_b', 'reason'];
    for (const key of requiredKeys) {
      if (!(key in obj)) {
        console.log('Output row ' + (i+1) + ' missing key: ' + key);
        allValid = false;
      }
    }
  } catch (e) {
    console.log('Output row ' + (i+1) + ' JSON parse error: ' + e.message);
    allValid = false;
  }
}

const idsMatch = JSON.stringify(inputIds) === JSON.stringify(outputIds);
console.log('IDs match:', idsMatch);

if (!idsMatch) {
  console.log('Input IDs:', inputIds);
  console.log('Output IDs:', outputIds);
}

console.log('All JSON valid:', allValid);
console.log('Row count match:', inputLines.length === outputLines.length);
"

