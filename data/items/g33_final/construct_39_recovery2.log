import json

input_path = 'data/items/g33_final/input_39.jsonl'
output_path = 'data/items/g33_final/generated_39_recovery2.jsonl'

with open(input_path) as f:
    input_lines = [l for l in f.read().strip().split('\n') if l.strip()]
with open(output_path) as f:
    output_lines = [l for l in f.read().strip().split('\n') if l.strip()]

print(f'Input rows: {len(input_lines)}')
print(f'Output rows: {len(output_lines)}')

input_ids = []
output_ids = []
all_valid = True

for i, line in enumerate(input_lines):
    try:
        obj = json.loads(line)
        input_ids.append(obj['id'])
    except Exception as e:
        print(f'Input row {i+1} parse error: {e}')
        all_valid = False

for i, line in enumerate(output_lines):
    try:
        obj = json.loads(line)
        output_ids.append(obj['id'])
        required = ['id','a_relation','b_relation','source_valid','x_a','x_b','reason']
        for k in required:
            if k not in obj:
                print(f'Output row {i+1} missing key: {k}')
                all_valid = False
    except Exception as e:
        print(f'Output row {i+1} parse error: {e}')
        all_valid = False

ids_match = input_ids == output_ids
print(f'IDs match: {ids_match}')
print(f'Row count match: {len(input_lines) == len(output_lines)}')
print(f'All JSON valid: {all_valid}')

parsed = [json.loads(l) for l in output_lines]
valid_count = sum(1 for r in parsed if r['source_valid'])
print(f'Valid pairs: {valid_count}')
print(f'Invalid pairs: {len(parsed) - valid_count}')
"

