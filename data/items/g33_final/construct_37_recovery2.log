const fs = require('fs');
const inputPath = '/home/xiang/research_hun/try_clone/data/items/g33_final/input_37.jsonl';
const outputPath = '/home/xiang/research_hun/try_clone/data/items/g33_final/generated_37_recovery2.jsonl';
const inputLines = fs.readFileSync(inputPath, 'utf8').trim().split('\n');
const outputLines = fs.readFileSync(outputPath, 'utf8').trim().split('\n');
console.log('Input rows:', inputLines.length);
console.log('Output rows:', outputLines.length);
let allValid = true;
const inputIds = [];
const outputIds = [];
for (let i = 0; i < inputLines.length; i++) {
  try { const obj = JSON.parse(inputLines[i]); inputIds.push(obj.id); }
  catch (e) { console.log('Input row ' + (i+1) + ' JSON parse error:', e.message); allValid = false; }
}
for (let i = 0; i < outputLines.length; i++) {
  try {
    const obj = JSON.parse(outputLines[i]);
    outputIds.push(obj.id);
    const requiredKeys = ['id', 'a_relation', 'b_relation', 'source_valid', 'x_a', 'x_b', 'reason'];
    for (const key of requiredKeys) { if (!(key in obj)) { console.log('Output row ' + (i+1) + ' (' + obj.id + ') missing key:', key); allValid = false; } }
    if (typeof obj.source_valid !== 'boolean') { console.log('Output row ' + (i+1) + ' (' + obj.id + ') source_valid not boolean'); allValid = false; }
    if (!['support','refute','unclear'].includes(obj.a_relation)) { console.log('Output row ' + (i+1) + ' (' + obj.id + ') invalid a_relation:', obj.a_relation); allValid = false; }
    if (!['support','refute','unclear'].includes(obj.b_relation)) { console.log('Output row ' + (i+1) + ' (' + obj.id + ') invalid b_relation:', obj.b_relation); allValid = false; }
  } catch (e) { console.log('Output row ' + (i+1) + ' JSON parse error:', e.message); allValid = false; }
}
const idsMatch = inputIds.length === outputIds.length && inputIds.every((id, i) => id === outputIds[i]);
console.log('IDs match:', idsMatch);
if (!idsMatch) { console.log('Input IDs:', inputIds.join(', ')); console.log('Output IDs:', outputIds.join(', ')); allValid = false; }
const validCount = outputLines.filter(l => JSON.parse(l).source_valid === true).length;
const invalidCount = outputLines.filter(l => JSON.parse(l).source_valid === false).length;
console.log('Valid pairs:', validCount);
console.log('Invalid pairs:', invalidCount);
console.log('All checks passed:', allValid && idsMatch && inputLines.length === outputLines.length);
"

