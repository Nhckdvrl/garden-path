import json

with open('data/items/g33_final/audit_35_recovery1.jsonl') as f:
    lines = f.read().strip().split('\n')

print('Row count:', len(lines))

ids = []
all_valid = True
for i, line in enumerate(lines):
    try:
        obj = json.loads(line)
        ids.append(obj['id'])
        required = ['id','e_a_relation','e_b_relation','x_a_relation','x_b_relation','source_valid','faithful','natural','accept','reason']
        for field in required:
            if field not in obj:
                print(f'Row {i+1} ({obj.get(\"id\",\"?\")}): missing field \"{field}\"')
                all_valid = False
    except Exception as e:
        print(f'Row {i+1}: invalid JSON - {e}')
        all_valid = False

print('All JSON valid:', all_valid)
print('IDs:', ids)

with open('data/items/g33_final/review_35.jsonl') as f:
    input_lines = f.read().strip().split('\n')
input_ids = [json.loads(l)['id'] for l in input_lines]
print('Input IDs:', input_ids)
print('IDs match:', ids == input_ids)
print('Input row count:', len(input_lines))
