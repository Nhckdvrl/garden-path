import json

with open('data/items/g33_final/input_03.jsonl', 'r') as f:
    input_rows = [json.loads(line) for line in f if line.strip()]

with open('data/items/g33_final/generated_03_attempt2.jsonl', 'r') as f:
    output_rows = [json.loads(line) for line in f if line.strip()]

input_ids = [row['id'] for row in input_rows]
output_ids = [row['id'] for row in output_rows]

print(f'Input row count: {len(input_rows)}')
print(f'Output row count: {len(output_rows)}')
print(f'IDs match: {input_ids == output_ids}')

required_keys = {'id', 'a_relation', 'b_relation', 'source_valid', 'x_a', 'x_b', 'reason'}
for i, row in enumerate(output_rows):
    missing = required_keys - set(row.keys())
    if missing:
        print(f'Row {i} ({row.get(\"id\", \"unknown\")}) missing keys: {missing}')

for row in output_rows:
    if row['source_valid']:
        if not row['x_a'] or not row['x_b']:
            print(f'ERROR: {row[\"id\"]} marked valid but x_a or x_b is empty')
    else:
        if row['x_a'] or row['x_b']:
            print(f'ERROR: {row[\"id\"]} marked invalid but x_a or x_b is non-empty')

print('Validation complete.')
"
