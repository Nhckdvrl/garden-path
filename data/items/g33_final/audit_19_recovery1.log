import json
with open('data/items/g33_final/audit_19_recovery1.jsonl', 'r') as f:
    lines = f.readlines()
print(f'Row count: {len(lines)}')
ids = []
for i, line in enumerate(lines, 1):
    row = json.loads(line)
    ids.append(row['id'])
    required = ['id', 'e_a_relation', 'e_b_relation', 'x_a_relation', 'x_b_relation', 'source_valid', 'faithful', 'natural', 'accept', 'reason']
    missing = [f for f in required if f not in row]
    if missing:
        print(f'Row {i} ({row[\"id\"]}): MISSING fields: {missing}')
    else:
        print(f'Row {i} ({row[\"id\"]}): OK - accept={row[\"accept\"]}')
print(f'All IDs: {ids}')
print(f'Unique IDs: {len(set(ids))}')
